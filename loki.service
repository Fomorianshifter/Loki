[Unit]
Description=Loki Raspberry Pi Display Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/loki
ExecStart=/opt/loki/.venv/bin/python3 /opt/loki/main.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
